{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-runtime-intelligence-os/run-schema-v0.1.json",
  "title": "AI Runtime Intelligence Experiment Run",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "benchmark_id",
    "policy_variant",
    "started_at",
    "environment",
    "outcome"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "run_id": { "type": "string", "minLength": 1 },
    "benchmark_id": { "type": "string", "minLength": 1 },
    "policy_variant": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": ["string", "null"], "format": "date-time" },
    "environment": {
      "type": "object",
      "required": ["runtime", "task_snapshot"],
      "properties": {
        "runtime": { "type": "string" },
        "runtime_version": { "type": ["string", "null"] },
        "task_snapshot": { "type": "string" },
        "repository_commit": { "type": ["string", "null"] },
        "provider": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "model_version": { "type": ["string", "null"] },
        "reasoning_effort": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "resources": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoning_tokens_or_units": { "type": ["number", "null"], "minimum": 0 },
        "context_peak_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "instruction_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "model_calls": { "type": ["integer", "null"], "minimum": 0 },
        "agent_count": { "type": ["integer", "null"], "minimum": 0 },
        "subagent_count": { "type": ["integer", "null"], "minimum": 0 },
        "tool_calls": { "type": ["integer", "null"], "minimum": 0 },
        "repeated_tool_calls": { "type": ["integer", "null"], "minimum": 0 },
        "verification_calls": { "type": ["integer", "null"], "minimum": 0 },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "cost": {
      "type": "object",
      "properties": {
        "currency": { "type": "string", "default": "USD" },
        "model": { "type": ["number", "null"], "minimum": 0 },
        "tools": { "type": ["number", "null"], "minimum": 0 },
        "verification": { "type": ["number", "null"], "minimum": 0 },
        "infrastructure": { "type": ["number", "null"], "minimum": 0 },
        "human_review": { "type": ["number", "null"], "minimum": 0 },
        "total": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "progress": {
      "type": "object",
      "properties": {
        "useful_state_changes": { "type": ["integer", "null"], "minimum": 0 },
        "no_progress_intervals": { "type": ["integer", "null"], "minimum": 0 },
        "repeated_operation_groups": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "outcome": {
      "type": "object",
      "required": ["success", "mandatory_compliance"],
      "properties": {
        "success": { "type": "boolean" },
        "quality_score": { "type": ["number", "null"] },
        "reliability_score": { "type": ["number", "null"] },
        "mandatory_compliance": { "type": "boolean" },
        "safety_compliance": { "type": ["boolean", "null"] },
        "grounding_score": { "type": ["number", "null"] },
        "human_correction_required": { "type": ["boolean", "null"] },
        "residual_risk": { "type": ["string", "null"] },
        "evaluator_id": { "type": ["string", "null"] },
        "evaluator_version": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "interventions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "reason": { "type": ["string", "null"] },
          "accepted": { "type": ["boolean", "null"] },
          "policy_version": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
